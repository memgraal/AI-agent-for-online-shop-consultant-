LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CONCURRENT_REQUESTS=64
LLM_QUEUE_TIMEOUT_SECONDS=5
LLM_QUICK_MAX_OUTPUT_TOKENS=400
LLM_MAX_OUTPUT_TOKENS=1200
# Для Yandex Cloud: LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# LLM_BASE_URL можно не задавать: используется https://ai.api.cloud.yandex.net/v1
# JEv-классификатор FAQ и товаров админки настраивается отдельно от чата:
JEV_LLM_API_KEY=
JEV_LLM_MODEL=typesafe/jev-1.14
JEV_LLM_BASE_URL=https://routerai.ru/api
ADMIN_API_KEY=
AGENT_RECURSION_LIMIT=12
AGENT_MAX_LLM_CALLS=6
CHAT_CONTEXT_MAX_MESSAGES=20
CHAT_MAX_CONTEXT_TOKENS=16000
CHAT_MAX_SESSIONS=10000
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_MAX_TEXT_CHARS=200000
KNOWLEDGE_MAX_PDF_PAGES=500
KNOWLEDGE_MAX_DOCUMENTS=5000
KNOWLEDGE_MAX_CHUNKS=10000
KNOWLEDGE_MAX_INDEXED_CHARS=10000000
OPERATOR_QUEUE_MAX_ITEMS=1000
OPERATOR_QUEUE_TTL_SECONDS=86400
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_CLIENTS=10000
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated exact frontend origins. Example: https://sss-shop.example
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/sss-ai.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Docker Compose: PostgreSQL используется FAQ Workbench, порт БД наружу не открыт.
POSTGRES_DB=sss_faq
POSTGRES_USER=sss_faq
# Перед запуском задайте случайное значение, например: openssl rand -hex 32
POSTGRES_PASSWORD=
FAQ_ADMIN_API_KEY=
FAQ_ALLOWED_ORIGINS=http://localhost:3000
FAQ_API_PORT=8010
