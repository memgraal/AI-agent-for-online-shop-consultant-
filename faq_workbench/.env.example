FAQ_DATABASE_URL=postgresql+asyncpg://faq_user:change-me@127.0.0.1:5432/sss_faq
FAQ_ADMIN_API_KEY=generate-a-long-random-faq-admin-secret
FAQ_AI_SERVICE_URL=http://127.0.0.1:8000
FAQ_AI_ADMIN_API_KEY=use-the-main-service-ADMIN_API_KEY
FAQ_AI_API_TIMEOUT_SECONDS=90
FAQ_API_RATE_LIMIT_MAX_REQUESTS=120
FAQ_API_RATE_LIMIT_WINDOW_SECONDS=60
FAQ_API_RATE_LIMIT_MAX_CLIENTS=10000
# Exact frontend origins, comma-separated. No path or trailing slash.
FAQ_ALLOWED_ORIGINS=https://shop.example.ru
FAQ_LOG_LEVEL=INFO
FAQ_ANALYSIS_MIN_NEW_QUESTIONS=50
FAQ_ANALYSIS_MIN_INTERVAL_HOURS=24
FAQ_ANALYSIS_LOCK_MINUTES=10
FAQ_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAQ_EMBEDDING_SIMILARITY_THRESHOLD=0.82
